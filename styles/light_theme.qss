/* Global Widget Styles */
QWidget {
    font-size: 13px;
    color: #333333;
    background-color: #FFFFFF;
}

/* Button Styles */
QPushButton {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 5px 15px;
    background-color: #ffffff;
    margin-left: 8px;
    margin-right: 8px;
}
QPushButton:hover {
    background-color: #e7e7e7;
}
QPushButton:pressed {
    background-color: #d7d7d7;
}

/* CheckBox Styles */
QCheckBox {
    spacing: 5px;
}
QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border-radius: 6px;
}
QCheckBox::indicator:unchecked {
    border: 1px solid #d7d7d7;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    image: url('Icons/tabler/themed/check-light.svg');
}

/* ComboBox Styles */
QComboBox {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 5px 10px;
    background-color: #ffffff;
    selection-background-color: #56CCF2;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left-width: 1px;
    border-left-color: #ced4da;
    border-left-style: solid;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QComboBox::down-arrow {
    image: url('Icons/tabler/themed/chevron-down-light.svg');
    width: 16px;
    height: 16px;
}
QComboBox:hover {
    border: 1px solid #a2a9b1;
}
QComboBox::drop-down:hover {
    background-color: #f5f5f5;
}

/* Dock Widget Styles */
QDockWidget {
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    background-color: #ffffff;
}
QDockWidget::title {
    background: #f5f5f5;
    padding: 1px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;

}
QDockWidget::close-button, QDockWidget::float-button {
    border: 1px solid transparent;
    border-radius: 6px;
    background: #f5f5f5;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: #e7e7e7;
}
QDockWidget::close-button:pressed, QDockWidget::float-button:pressed {
    background: #d7d7d7;
}

/* Frame Styles */
QFrame {
    background-color: #ffffff;
    border: none; /* Remove border from all QFrames by default */
}

/* Only apply borders to specific frames where needed */
QFrame#search_results_frame, QDockWidget > QFrame {
    border: 1px solid #E5E5E5;
}

/* List and Table Widget Styles */
QListWidget, QTableWidget {
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    background-color: #ffffff;
}
QListWidget::item, QTableWidget::item {
    padding: 5px;
}
QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #f2f2f2;
    color: #333333;
}


/* Menu and MenuBar Styles */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E5E5;
}
QMenuBar::item {
    padding: 5px 8px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #e7e7e7;
}
QMenuBar::item:pressed {
    background-color: #d7d7d7;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #C0C0C0;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 5px 25px 5px 10px;
    border-radius: 4px;
    color: #333333;
}
QMenu::item:selected {
    background-color: #e7e7e7;
}
QMenu::item:pressed {
    background-color: #d7d7d7;
}
QMenu::separator {
    height: 1px;
    background-color: #E5E5E5;
    margin: 3px 5px;
}

/* MessageBox Styles */
QMessageBox {
    background-color: #ffffff;
    border: 1px solid #E5E5E5;
}

QScrollBar:vertical {
    border: none;
    background: #F8F8F8;
    width: 10px;
    margin: 0px;
    border-radius: 0px;
}

QScrollBar::handle:vertical {
    background: #C1C1C1;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical {
    border: none;
    background: none;
    height: 0px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar:horizontal {
    border: none;
    background: #F8F8F8;
    height: 10px;
    margin: 0px;
    border-radius: 0px;
}

QScrollBar::handle:horizontal {
    background: #C1C1C1;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical,
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}



/* Slider Styles */
QSlider::groove:horizontal {
    border: 1px solid #E5E5E5;
    height: 8px;
    background: #ffffff;
    margin: 2px 0;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #E5E5E5;
    width: 14px;
    margin: -2px 0;
    border-radius: 6px;
}
QSlider::handle:horizontal:hover {
    background: #b7b7b7;
}
QSlider::handle:horizontal:pressed {
    background: #c7c7c7;
}
QSlider::add-page:horizontal {
    background: #e7e7e7;
    border: 1px solid #E5E5E5;
    height: 8px;
    border-radius: 4px;
}

/* TabWidget and TabBar Styles */
QTabWidget {
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    background-color: #ffffff;
}

QTabWidget::pane {
    border-top: 1px solid #E5E5E5;
    background-color: #FFFFFF;
}

QTabBar {
    background-color: #FFFFFF;
}

QTabBar::tab {
    background: #F5F5F5;
    border: 1px solid #E5E5E5;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 8ex;
    padding: 5px;
    color: #333333;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background: #FFFFFF;
}

QTabBar::tab:selected {
    border-color: #C2C7CB;
    border-bottom-color: #FFFFFF; /* Same as tab background for seamless transition */
}

QTabBar::tab:!selected {
    margin-top: 2px; /* Unselected tabs are slightly raised */
}

/* ToolBar Styles */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E5E5;
    /* Symmetric vertical padding so controls sit centred rather than
       pushed against the top edge. TOOLBAR_HEIGHT in constants.py is
       derived from these numbers -- change one and change the other. */
    padding: 5px 8px;
    spacing: 6px;
}
QToolBar::item:hover {
    background-color: #e7e7e7;
}
QToolBar::item:pressed {
    background-color: #d7d7d7;
}

/* Other Widget Styles */
QLineEdit, QTextEdit, QAudioWidget {
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    background-color: #ffffff;
}
QLineEdit:hover, QTextEdit:hover {
    border: 1px solid #a2a9b1;
}
QLineEdit:focus {
    border: 1px solid #56CCF2;
}

QTreeWidget {
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    background-color: #ffffff;
}


/* Action Styles */
QAction {
    padding: px 10px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    background-color: #ffffff;
}
QAction:hover {
    background-color: #f5f5f5;
    border: 1px solid #a2a9b1;
}
QAction:pressed {
    background-color: #e7e7e7;
    border: 1px solid #56CCF2;
}

QGroupBox {
    border-radius: 4px;
    border: 1px solid #E5E5E5;
    background-color: #FFFFFF;
}


#exportButton {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 5px 30px 5px 5px; /* Adjust right padding to push text more to the left */
    background-color: #ffffff;
    width: 60px; /* Adjust width as necessary to fit text and menu arrow */
}

#exportButton::menu-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left-width: 1px;
    border-left-color: #ced4da;
    border-left-style: solid;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}

#exportButton::menu-button:hover {
    background-color: #ced4da;
}

#exportButton::menu-arrow {
    image: url('Icons/tabler/themed/chevron-down-light.svg');
    width: 16px;  /* Adjust the width of the image */
    height: 16px;  /* Adjust the height of the image */
}




/* General styles for all QTableWidgets, QTreeWidgets, and QListWidgets in light theme */
QTableWidget, QTreeWidget, QListWidget {
    gridline-color: #E5E5E5;  /* Light gridline color */
    font-size: 13px;
    background-color: #FFFFFF;  /* Light background for tables */
    color: #000000;  /* Dark text color */
}

/* Table items */
QTableWidget::item, QTreeWidget::item, QListWidget::item {
    padding: 5px;
    color: #000000;  /* Dark text color */
    background-color: #FFFFFF;  /* White background for table rows */
}

QTableWidget::item:selected, QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #CCE8FF;  /* Light blue highlight for selected items */
}

/* Header styles for all tables and trees */
QHeaderView::section {
    background-color: #F5F5F5;  /* Light gray header background */
    color: #000000;  /* Dark text color */
    padding: 5px;
    border-style: none;
    border-bottom: 1px solid #E5E5E5;
    border-right: 1px solid #E5E5E5;
}

QHeaderView::section:horizontal {
    border-top: 1px solid #E5E5E5;
}

/* Specific styles for listingTable's header to remove extra space */
#listingTable QHeaderView::section:horizontal {
    border-top: 1px solid #E5E5E5;
    margin-top: 0px;
    padding-top: 2px;
}

QHeaderView::section:vertical {
    border-left: 1px solid #E5E5E5;
}

/* Set the alternating row colors for better visibility */
QTableWidget, QTreeWidget, QListWidget {
    alternate-background-color: #F8F8F8;  /* Very light gray for alternating rows */
}

/* Vertical header (row numbers) */
QHeaderView::section:vertical {
    background-color: #F5F5F5;  /* Same color as table background */
    color: #000000;  /* Dark text color */
}

/* Styles for scrollbars in light theme */
QScrollBar:vertical, QScrollBar:horizontal {
    background: #F0F0F0;  /* Light background for scrollbars */
    width: 10px;
    height: 10px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #C0C0C0;  /* Scroll handle color */
    border-radius: 6px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    height: 0px;
    width: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Vertical header style for row numbers */
QHeaderView::section:vertical {
    background-color: #F5F5F5;  /* Match the table background */
}

/* Styles specifically for lists and tree items in light theme */
QListWidget, QTreeWidget::item {
    background-color: #FFFFFF;  /* White background for rows */
    color: #000000;  /* Dark text color */
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #CCE8FF;  /* Light blue highlight for selected items */
}

#softwareInfoLabel {
    font-size: 19px;             /* Slightly larger font for the main title */
    font-weight: bold;
    color: #333333;              /* Dark text color */
    padding: 10px 0;             /* Add some vertical padding */
}

#subtitleLabel {
    font-size: 15px;
    color: #666666;              /* Medium gray for the subtitle */
    padding: 5px 0;              /* Add a little space around the subtitle */
}

/* Search Results Area Styling for Light Theme */
#search_results_frame {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    padding: 1px;
}

#search_results_title {
    background-color: #F0F0F0;
    color: #333333;
    padding: 2px;
    border-bottom: 1px solid #D3D3D3;
}

#search_results_widget {
    background-color: #FFFFFF;
    color: #333333;
    border: none;
    font-size: 11px;
}

#search_results_widget::item {
    padding: 2px;
}

#search_results_widget::item:selected {
    background-color: #CCE8FF;
}

/* Address bar in hex view */
QLabel[text="Address"] {
    background-color: #F5F5F5;
    color: #333333;
}

QLabel[text="00"], QLabel[text="01"], QLabel[text="02"], QLabel[text="03"],
QLabel[text="04"], QLabel[text="05"], QLabel[text="06"], QLabel[text="07"],
QLabel[text="08"], QLabel[text="09"], QLabel[text="0A"], QLabel[text="0B"],
QLabel[text="0C"], QLabel[text="0D"], QLabel[text="0E"], QLabel[text="0F"],
QLabel[text="ASCII"] {
    background-color: #F5F5F5;
    color: #333333;
}

/* UnifiedViewer Placeholder Label - "No content loaded" message */
#placeholderLabel {
    background-color: #F0F0F0;  /* Light gray background */
    font-size: 15px;
    color: #888888;  /* Medium gray text */
    padding: 10px;
}

/* AudioVideoPlayer Audio-Only Label - "Playing Audio" message */
#audioOnlyLabel {
    background-color: #E0E0E0;  /* Light gray background */
    font-size: 19px;
    color: #444444;  /* Dark gray text */
    padding: 20px;
}

/* Toolbar Compact Styles - for PictureViewer and PDFViewer */


/* Media Player Sliders - Position and Volume */
QSlider::groove:horizontal {
    height: 5px;
    margin: 2px 0;
}

QSlider::handle:horizontal {
    width: 10px;
    margin: -3px 0;
}

/* Search Toolbar Styles (Listing View) */
/* Colour only. Padding, height and radius come from the shared
   QLineEdit rule, so every search box in the application matches.
   This block used to set `padding: 6px 10px`, and because an ID
   selector outranks the generic rule, 12px of vertical padding was
   applied inside a 24px-tall field -- which clipped the placeholder. */
QLineEdit#listingSearchBar {
    border: 1px solid #C0C0C0;
    background-color: #FFFFFF;
    color: #333333;
}

QLineEdit#listingSearchBar:hover {
    border: 1px solid #999999;
}

QLineEdit#listingSearchBar:focus {
    border: 1px solid #2F81F7;
}

QToolButton#clearSearchBtn {
    border: 1px solid #C0C0C0;
    border-radius: 4px;
    background-color: #F5F5F5;
    padding: 4px;
}

QToolButton#clearSearchBtn:hover {
    background-color: #E7E7E7;
    border: 1px solid #999999;
}

QToolButton#clearSearchBtn:pressed {
    background-color: #D7D7D7;
}

/* File Type Filter GroupBox */
QGroupBox#fileTypeGroup {
    border: none;
    background-color: transparent;
    padding: 0px;
    margin: 0px;
}

QGroupBox#fileTypeGroup QCheckBox {
    spacing: 6px;
    font-size: 13px;
    padding: 2px;
    color: #333333;
}

QGroupBox#fileTypeGroup QCheckBox:hover {
    color: #000000;
}

/* ==================== Volume information dialog ==================== */
/* Previously these colours were hardcoded inline in volume_info.py, which
   made the dialog unreadable in dark mode (dark text on a dark ground). */

QWidget#volumeInfoHeader {
    background-color: #f8f9fa;
    border-bottom: 2px solid #dee2e6;
}

QWidget#volumeInfoCard {
    background-color: #ffffff;
    border-radius: 8px;
    border: 1px solid #dee2e6;
}

QWidget#volumeInfoRow {
    border: none;
}

QLabel#volumeInfoTitle {
    font-size: 19px;
    font-weight: bold;
    color: #212529;
    border: none;
}

QLabel#volumeInfoSubtitle {
    font-size: 15px;
    font-weight: bold;
    color: #212529;
    border: none;
}

QLabel#volumeInfoSectionTitle {
    font-size: 15px;
    font-weight: bold;
    color: #212529;
    padding-bottom: 10px;
}

QLabel#volumeInfoFieldLabel {
    font-weight: bold;
    color: #495057;
    font-size: 13px;
    border: none;
}

QLabel#volumeInfoFieldValue {
    color: #212529;
    font-size: 13px;
    border: none;
}

QLabel#volumeInfoLegendLabel {
    color: #495057;
    font-size: 11px;
    border: none;
}

QChartView#volumeInfoChartView {
    border: none;
    background: transparent;
}

/* ==================== Migrated inline styles ==================== */
/* These were setStyleSheet() calls in Python, so the widgets could not
   respond to a theme change at all. Object names let both themes style them. */

/* Panel titles: File System Browser / File Carving / Registry Browser.
   Previously three copies of the same inline rule using a teal (#37c6d0)
   that clashed with the blue used for selection. Headings are plain
   foreground text now -- blue is reserved for selection and progress,
   where it means something. */
QLabel#panelTitle {
    font-size: 13px;
    font-weight: 600;
    color: #212529;
    margin-left: 6px;
    padding: 2px 0;
}

QTableWidget#hexTable {
    gridline-color: transparent;
    border: 1px solid #d3d3d3;
}

QTableWidget#hexTable::item {
    padding: 0px;
    border: none;
}

QHeaderView#hexTableHeader::section {
    padding: 2px;
}

QHeaderView#listingTableHeader::section {
    margin-top: 0px;
    padding-top: 2px;
}

QTextEdit#hashResultBox {
    background-color: #f5f5f5;
    border: 1px solid #ced4da;
    color: #212529;
    font-family: 'Courier New', Courier, monospace;
}

QProgressBar#verifyProgress {
    border: 1px solid #ced4da;
    border-radius: 4px;
    text-align: center;
    background-color: #f5f5f5;
    color: #212529;
}

QProgressBar#verifyProgress::chunk {
    /* Green because the bar reports a hash verification completing, and the
       theme's amber [state="warning"] already establishes that colour carries
       meaning in this app. The previous #2F81F7 was a blue used nowhere else
       and said nothing about the outcome. */
    background-color: #2DA44E;
    border-radius: 4px;
}

QTextEdit#borderlessView {
    border: 0px;
}

/* ==================== Property tables ==================== */
/* A properties pane is read, not navigated, so it drops the header row, the
   grid and the row stripes a data table wants. Right-aligned labels against
   left-aligned values give the eye one clean edge to follow. */

QTableWidget#propertyTable {
    border: none;
    background-color: transparent;
    color: #212529;
    gridline-color: transparent;
    outline: none;
}

QTableWidget#propertyTable::item {
    padding: 3px 12px 3px 8px;
    border: none;
}

QTableWidget#propertyTable::item:selected {
    background-color: #d7e7fb;
    color: #212529;
}

/* Field names: quieter than their values, which carry the information. */
QTableWidget#propertyTable::item[state="label"] {
    color: #6b7480;
}

/* Section headings ("File", "Timestamps", "Hashes"). */
QTableWidget#propertyTable::item[state="section"] {
    color: #495057;
    padding-top: 10px;
    padding-bottom: 3px;
}

QTableWidget#propertyTable::item[state="warning"] {
    color: #b45309;
}



QLabel#panelIcon {
    padding: 0 4px 0 8px;
}

QLabel#vtVerdict {
    font-size: 15px;
    font-weight: 600;
    padding: 6px 2px;
    color: #495057;
}

QLabel#vtVerdict[state="malicious"] { color: #c02b2b; }
QLabel#vtVerdict[state="clean"] { color: #1a7f37; }

QLabel#vtSectionLabel {
    font-weight: 600;
    color: #6b7480;
    padding-top: 8px;
}

/* ==================== Metadata pane ==================== */
/* One scroll area holding the property table and the low-level dump, so the
   pane has a single scrollbar instead of two competing ones. */

QScrollArea#metadataScroll,
QWidget#metadataContent {
    background-color: #ffffff;
    border: none;
}

QLabel#detailHeading {
    font-size: 13px;
    font-weight: 600;
    color: #495057;
    padding: 14px 0 4px 8px;
    border-top: 1px solid #e9ecef;
    margin-top: 10px;
}

QPlainTextEdit#monoDetailView {
    border: none;
    background-color: transparent;
    color: #495057;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 12px;
    padding: 2px 8px;
}

QLabel#emptyStateLabel {
    color: #868e96;
    font-size: 13px;
    padding: 12px 8px;
}

/* ==================== Controls ==================== */
/* Height is set here and nowhere else. Qt adds padding and border on top of
   min-height, so these values are chosen to total the same rendered height for
   every control: 6px padding + 2px border + 16px content = 24px.
   Python must not also call setFixedHeight, or the two disagree and the larger
   wins -- which is what left toolbars with 24, 32, 34, 36 and 38px controls
   sitting side by side. */

QLineEdit, QComboBox, QSpinBox {
    padding: 0px 8px;
    border-radius: 4px;
    min-height: 26px;
    max-height: 26px;
}

QPushButton {
    padding: 0px 14px;
    border-radius: 4px;
    min-height: 26px;
    max-height: 26px;
    min-width: 80px;
}

QComboBox::drop-down {
    width: 20px;
    border-left: none;
}

/* Toolbar buttons: square, so an icon sits centred in its hover highlight
   rather than floating in a wide rectangle. */
QToolBar QToolButton {
    /* Transparent until hovered. Without this, Qt paints its default button
       fill, which is a shade lighter than the bar and put a faint panel behind
       every icon. */
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px 1px;
    border-radius: 4px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

QToolBar QToolButton:hover {
    background-color: #e9ecef;
}

QToolBar QToolButton:pressed {
    background-color: #dee2e6;
}

/* Buttons that carry a label need room for it. The square rule above caps
   width at 28px; these override the minimum and leave the maximum alone.
   Naming 16777215px here was Qt's own limit, and setting it explicitly made
   Qt warn "the largest allowed size is (16777215,16777215)" on every such
   button at startup. */
QToolBar QToolButton[popupMode="1"],
QToolBar QToolButton#clearSearchBtn,
QToolBar QPushButton {
    min-width: 0px;
    max-width: none;
}

/* Labels inside a toolbar: match the control height so text baselines line up
   with the fields beside them. */
QToolBar QLabel {
    min-height: 26px;
    max-height: 26px;
    padding: 0px 2px;
}

/* ==================== About dialog ==================== */
QDialog#aboutDialog {
    background-color: #ffffff;
}

QLabel#aboutTitle {
    font-size: 19px;
    font-weight: 600;
    color: #212529;
    padding-bottom: 2px;
}

QLabel#aboutSubtitle {
    font-size: 13px;
    color: #6b7480;
}

QLabel#aboutMeta {
    font-size: 13px;
    color: #495057;
    padding: 1px 0;
}

QLabel#aboutMetaQuiet {
    font-size: 11px;
    color: #868e96;
    padding-top: 6px;
}

/* ============ Multi-select and menu buttons ============ */

/* Shows a text summary, so it is styled like a combo box. */
QToolButton#multiSelectButton {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 4px;
    color: #212529;
    padding: 0px 10px;
    min-width: 92px;
    max-width: 140px;
    text-align: center;
}

QToolButton#multiSelectButton:hover {
    background-color: #f1f3f5;
}

QToolButton#multiSelectButton:pressed {
    background-color: #e9ecef;
}

/* The export button is icon-only, so it must look like the navigation
   buttons beside it -- no border, no minimum width. It previously shared the
   rule above, which framed it and forced it 92px wide inside a 28px slot. */
QToolButton#exportButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-width: 0px;
    max-width: 16777215px;
}

QToolButton#exportButton:hover {
    background-color: #f1f3f5;
    border-radius: 4px;
}

QToolButton#exportButton:pressed {
    background-color: #e9ecef;
}

/* No arrow overlay: the whole button is the icon. */
QToolButton#exportButton::menu-indicator,
QToolButton#multiSelectButton::menu-indicator {
    image: none;
    width: 0px;
}

/* Group divider inside a toolbar. A visible rule makes it obvious where one
   group of controls ends and the next begins -- the blank spacers these
   replaced left the bars reading as one long undifferentiated row. */
/* Group divider inside a toolbar. A visible rule makes it obvious where one
   group of controls ends and the next begins -- the blank spacers these
   replaced left the bars reading as one long undifferentiated row.

   Qt builds these as real QToolBarSeparator widgets, so they are targeted by
   type. The ::separator subcontrol rule does not reach them and leaves Qt
   drawing its default 17px block instead of a rule. */
QToolBarSeparator {
    background-color: #dee2e6;
    max-width: 1px;
    min-width: 1px;
    margin: 6px 8px;
}

/* The text viewer and the Application tab's placeholder are content surfaces,
   not input fields. Both previously sat a shade lighter than the other viewer
   tabs -- the text pane by inheriting the shared QTextEdit rule, the
   placeholder by setting its own colour -- so switching tabs changed the
   background under you. */
QTextEdit#textContentView {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
}

#placeholderLabel {
    background-color: #FFFFFF;
}

/* Selected text, everywhere it can be selected.

   Qt takes this from the palette when a stylesheet does not set it, and the
   platform default is a violet that matches nothing else here. Only QComboBox
   overrode it, so every other pane -- hex, text, metadata, the hash box --
   highlighted in that violet. These are the same colours the themes already
   use for a selected row, so selecting text and selecting a row now agree. */
QWidget {
    selection-background-color: #CCE8FF;
    selection-color: #212529;
}
