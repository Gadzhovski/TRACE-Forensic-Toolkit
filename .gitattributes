# Normalise text files in the repository.
* text=auto

# Shell scripts must keep LF endings: a CRLF shebang line makes the script
# fail on macOS/Linux with a confusing "bad interpreter" error.
*.sh text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf

# The website's source is not part of TRACE: leave it out of GitHub's
# "Download ZIP" and release source archives.
site/ export-ignore
